              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "title": {
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "multi_choice",
              "type": "string"
            }
          },
          "required": [
            "name",
            "title",
            "description",
            "type",
            "default",
            "choices"
          ],
          "type": "object"
        }
      ]
