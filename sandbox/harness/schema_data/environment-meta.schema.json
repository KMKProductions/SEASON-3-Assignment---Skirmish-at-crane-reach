            },
            "max": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "name": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "title": {
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "float",
              "type": "string"
            }
          },
          "required": [
            "name",
