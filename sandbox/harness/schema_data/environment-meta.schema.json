        {
          "additionalProperties": false,
          "properties": {
            "choices": {
              "items": {
                "$ref": "#/$defs/env_parameter_choice"
              },
              "minItems": 1,
              "type": "array"
            },
            "default": {
              "type": "string"
            },
            "description": {
              "minLength": 1,
              "type": "string"
            },
            "name": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "title": {
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "choice",
