    "builtin_agent": {
      "additionalProperties": false,
      "description": "One named built-in agent an environment stages and exposes.",
      "properties": {
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label"
      ],
      "type": "object"
    },
    "env_parameter": {
      "description": "A typed, player-facing gameplay parameter declared by an environment.",
      "oneOf": [
        {
          "additionalProperties": false,
