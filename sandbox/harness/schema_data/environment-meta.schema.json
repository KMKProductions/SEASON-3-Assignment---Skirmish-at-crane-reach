    "env_parameter_choice": {
      "additionalProperties": false,
      "description": "A friendly label for a string-valued choice.",
      "properties": {
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "type": "object"
    },
    "env_preset": {
      "additionalProperties": false,
      "description": "A named set of parameter values an environment offers as a convenient starting point.",
      "properties": {
        "example": {
          "minLength": 1,
          "type": "string"
        },
        "llm": {
          "type": "boolean"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "name",
        "title",
        "values"
      ],
      "type": "object"
    },
    "environment_layout": {
      "description": "How one environment organizes its PettingZoo players into playable seats.",
      "oneOf": [
        {
          "$ref": "#/$defs/player_bounds_layout"
        },
        {
          "$ref": "#/$defs/seat_plans_layout"
        }
      ]
    },
    "player_bounds_layout": {
      "additionalProperties": false,
      "description": "A player-count range where every player receives one assignable seat.",
      "properties": {
        "kind": {
          "const": "player_bounds",
          "type": "string"
        },
        "max": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        "min": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "min",
        "max"
      ],
      "type": "object"
    },
    "seat_declaration": {
      "additionalProperties": false,
      "description": "One declared seat, its player indexes, and any designated built-in agent.",
      "properties": {
        "players": {
          "items": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "restricted_builtin": {
          "type": "string"
        }
      },
      "required": [
        "players"
      ],
      "type": "object"
    },
    "seat_plan": {
      "additionalProperties": false,
      "description": "One named, complete assignment of PettingZoo players to seats.",
      "properties": {
        "key": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "seats": {
          "items": {
            "$ref": "#/$defs/seat_declaration"
          },
          "minItems": 1,
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "key",
        "title",
        "seats"
      ],
      "type": "object"
    },
    "seat_plans_layout": {
      "additionalProperties": false,
      "description": "The ordered layouts an environment may select through seat_plan.",
      "properties": {
        "kind": {
          "const": "seat_plans",
          "type": "string"
        },
        "plans": {
          "items": {
            "$ref": "#/$defs/seat_plan"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "kind",
        "plans"
      ],
      "type": "object"
    }
  },
  "$id": "https://vox-deorum.github.io/game-sandbox/schema/environment-meta.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The public-facing metadata for one environment, field-for-field the Python to_json().",
  "properties": {
    "builtin_agents": {
      "items": {
        "$ref": "#/$defs/builtin_agent"
      },
      "minItems": 1,
      "type": "array"
    },
    "description": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "env_id": {
      "type": "string"
    },
    "episode_limit_ms": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "human_pause": {
      "enum": [
        "session",
        "playback"
      ],
      "type": "string"
    },
    "human_players": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "human_timeout_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "layout": {
      "$ref": "#/$defs/environment_layout"
    },
    "live_interval_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "llm": {
      "type": "boolean"
    },
    "message_cap": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "messaging": {
      "type": "boolean"
    },
    "pace_interval_ms": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "parameters": {
      "items": {
        "$ref": "#/$defs/env_parameter"
      },
      "minItems": 1,
      "type": "array"
    },
    "presets": {
      "items": {
        "$ref": "#/$defs/env_preset"
      },
      "type": "array"
    },
    "recommended_episode_ticks": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "renderer": {
      "type": "string"
    },
    "seat_order_matters": {
      "type": "boolean"
    },
    "step_limit_ms": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
    },
    "stepping": {
      "enum": [
        "sequential",
        "simultaneous"
      ],
      "type": "string"
    },
    "view_interval_ms": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "env_id",
    "display_name",
    "description",
    "builtin_agents",
    "layout",
    "human_players",
    "human_timeout_ms",
    "recommended_episode_ticks",
    "pace_interval_ms",
    "stepping",
    "step_limit_ms",
    "episode_limit_ms",
    "messaging",
    "message_cap",
    "llm",
    "renderer",
    "seat_order_matters",
    "view_interval_ms",
    "live_interval_ms",
    "human_pause",
    "parameters"
  ],
  "title": "EnvironmentMeta",
  "type": "object"
}
