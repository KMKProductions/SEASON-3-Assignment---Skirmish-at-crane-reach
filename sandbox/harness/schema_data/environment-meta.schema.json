            }
          },
          "required": [
            "name",
            "title",
            "description",
            "type",
            "default"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "default": {
              "type": "boolean"
            },
            "description": {
              "minLength": 1,
              "type": "string"
            },
            "name": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "title": {
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "bool",
              "type": "string"
